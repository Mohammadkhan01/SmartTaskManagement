{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "RefreshTokenCookie": {
    "Name": "smarttask.refresh",
    "Path": "/api/",
    "SameSite": "Lax",
    "SecurePolicy": "Always"
  },
  "RateLimiting": {
  "Auth": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
}
