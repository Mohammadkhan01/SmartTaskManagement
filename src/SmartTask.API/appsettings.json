{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "RefreshTokenCookie": {
    "Name": "smarttask.refresh",
    "Path": "/api/",
    "SameSite": "Lax",
    "SecurePolicy": "Always"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Ai": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Ai": {
    "Provider": "OpenAI",
    "TimeoutSeconds": 20,
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "MaxOutputTokens": 1500,
    "Temperature": 0.2,
    "UseJsonResponseFormat": true
  }
}
